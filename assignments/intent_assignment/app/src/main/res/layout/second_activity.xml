<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="200dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/second_style"
        android:id="@+id/imgp1ImageView"

        />
    <ImageView
        android:layout_width="160dp"
        android:layout_height="200dp"
        app:layout_constraintLeft_toRightOf="@id/imgp1ImageView"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/second_style"
        android:id="@+id/imgp2ImageView"

        />

    <ImageView
        android:layout_width="160dp"
        android:layout_height="200dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgp1ImageView"
        style="@style/second_style"
        android:id="@+id/imgp3ImageView"

        />
    <ImageView
        android:layout_width="160dp"
        android:layout_height="200dp"
        app:layout_constraintLeft_toRightOf="@id/imgp3ImageView"
        app:layout_constraintTop_toBottomOf="@id/imgp2ImageView"
        style="@style/second_style"
        android:id="@+id/imgp4ImageView"

        />

</androidx.constraintlayout.widget.ConstraintLayout>