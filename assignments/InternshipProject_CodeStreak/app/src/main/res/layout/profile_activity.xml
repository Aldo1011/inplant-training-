<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/cs_secondary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"

            android:gravity="center"

            android:orientation="vertical"

            android:background="@color/cs_primary">

            <TextView
                android:id="@+id/profileAvatar"

                android:layout_width="92dp"
                android:layout_height="92dp"

                android:gravity="center"

                android:text="👤"

                android:textSize="42sp"

                android:background="@drawable/bg_stat_card"/>

            <TextView
                android:id="@+id/profileUsername"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:text="Username"

                android:textSize="25sp"
                android:textStyle="bold"

                android:textColor="@color/cs_white"/>

            <TextView
                android:id="@+id/profileEmail"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:text="Python Learner"

                android:textSize="14sp"

                android:textColor="#DDE5FF"/>

        </LinearLayout>


        <!-- STATS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"

            android:layout_margin="18dp"

            android:padding="8dp"

            android:gravity="center"

            android:orientation="horizontal"

            android:background="@drawable/bg_stat_card">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileXp"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="⭐ 0"

                    android:textSize="19sp"
                    android:textStyle="bold"

                    android:textColor="@color/cs_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="XP"

                    android:textSize="10sp"

                    android:textColor="@color/cs_text_muted"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileStreak"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="🔥 0"

                    android:textSize="19sp"
                    android:textStyle="bold"

                    android:textColor="@color/cs_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="STREAK"

                    android:textSize="10sp"

                    android:textColor="@color/cs_text_muted"/>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileLessons"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="0"

                    android:textSize="19sp"
                    android:textStyle="bold"

                    android:textColor="@color/cs_text"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="LESSONS"

                    android:textSize="10sp"

                    android:textColor="@color/cs_text_muted"/>

            </LinearLayout>

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"

            android:text="CURRENT WORLD"

            android:textSize="12sp"
            android:textStyle="bold"

            android:textColor="@color/cs_text_muted"/>


        <TextView
            android:id="@+id/profileWorld"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"

            android:text="The Awakening"

            android:textSize="24sp"
            android:textStyle="bold"

            android:textColor="@color/cs_text"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_margin="20dp"

            android:text="Keep learning Python and continue your journey through CodeStreak."

            android:textSize="15sp"
            android:lineSpacingExtra="3dp"

            android:textColor="@color/cs_text_muted"/>

    </LinearLayout>

</ScrollView>