<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/productImageView"
        android:layout_marginStart="20sp"
        android:layout_marginTop="20dp"

        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/productImageView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"

        android:layout_marginStart="20sp"
        android:layout_marginTop="20dp"
        android:id="@+id/prodictIdTextView"


        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/productImageView"
        app:layout_constraintTop_toBottomOf="@id/prodictIdTextView"
        app:layout_constraintRight_toRightOf="parent"

        android:layout_marginStart="20sp"
        android:layout_marginTop="20dp"
        android:id="@+id/prodictTitleTextView"


        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/productImageView"
        app:layout_constraintTop_toBottomOf="@id/prodictTitleTextView"
        app:layout_constraintRight_toRightOf="parent"

        android:layout_marginStart="20sp"
        android:layout_marginTop="20dp"
        android:id="@+id/prodictPriceTextView"


        />





</androidx.constraintlayout.widget.ConstraintLayout>